{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "default:automergeDigest"
  ],
  "packageRules": [
    {
      "description": "Every dependency that ends up inside the published image gets a patch release, so the update actually reaches users.",
      "matchFileNames": ["Dockerfile", "requirements.txt"],
      "postUpgradeTasks": {
        "commands": ["./scripts/renovate-patch-release.sh"],
        "fileFilters": ["VERSION", "CHANGELOG.md"],
        "executionMode": "branch"
      }
    }
  ]
}
