{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "default:automergeDigest"
  ],
  "packageRules": [
    {
      "description": "Every dependency that ends up inside the published image records a changelog entry, so merging it cuts a patch release the same way any other image-relevant merge does.",
      "matchFileNames": ["Dockerfile", "requirements.txt"],
      "postUpgradeTasks": {
        "commands": ["./scripts/renovate-changelog-entry.sh"],
        "fileFilters": ["VERSION", "CHANGELOG.md"],
        "executionMode": "branch",
        "dataFileTemplate": "{{#each upgrades}}{{{depName}}}\t{{{currentValue}}}\t{{{newValue}}}\t{{{currentDigestShort}}}\t{{{newDigestShort}}}\n{{/each}}"
      }
    }
  ]
}
